{
  "type": "object",
  "description": "Tarifler (docs/tasarim.md §4.3). Süre, fiyat ve açılma bedelleri GEÇİCİ; denge simülasyonuyla ayarlanacak",
  "required": ["recipes"],
  "properties": {
    "recipes": {
      "type": "array",
      "min_items": 1,
      "items": {
        "type": "object",
        "required": ["id", "name", "ingredients", "prep_minutes", "base_price_kurus", "unlock_cost_kurus"],
        "properties": {
          "id": { "type": "string", "min_length": 1, "description": "Benzersiz kimlik (snake_case)" },
          "name": { "type": "string", "min_length": 1, "description": "Oyuncuya gösterilen ad" },
          "ingredients": {
            "type": "array",
            "min_items": 1,
            "items": {
              "type": "object",
              "required": ["ingredient", "amount"],
              "properties": {
                "ingredient": { "type": "string", "min_length": 1, "description": "ingredients.json içindeki id" },
                "amount": { "type": "int", "minimum": 1 }
              }
            }
          },
          "prep_minutes": { "type": "int", "minimum": 1, "description": "Hazırlama süresi (oyun dakikası = tick)" },
          "base_price_kurus": { "type": "int", "minimum": 0, "description": "Önerilen satış fiyatı; oyuncu değiştirebilir" },
          "unlock_cost_kurus": { "type": "int", "minimum": 0, "description": "Açma bedeli; 0 = oyun başında açık" }
        }
      }
    }
  }
}
